APP_NAME=BookHive
APP_VERSION=1.0.0
APP_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:4200

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bookhive
DATABASE_USER=postgres
DATABASE_PASSWORD=admin

# Database startup configuration
RESET_DATABASE_ON_STARTUP=true
SEED_DATABASE_ON_STARTUP=true
SEED_DEMO_DATA=false

# Initial administrator
INITIAL_ADMIN_FULL_NAME=BookHive Administrator
INITIAL_ADMIN_USERNAME=bookhive_admin
INITIAL_ADMIN_EMAIL=admin@bookhive.com
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_password

# Initial super administrator
INITIAL_SUPER_ADMIN_FULL_NAME=BookHive Super Administrator
INITIAL_SUPER_ADMIN_USERNAME=bookhive_super_admin
INITIAL_SUPER_ADMIN_EMAIL=superadmin@bookhive.com
INITIAL_SUPER_ADMIN_PASSWORD=replace_with_a_secure_password

# Generate a secure value using: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Email delivery (Gmail SMTP example)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
SMTP_FROM_EMAIL=your_sender@gmail.com
SMTP_USE_TLS=true

STORAGE_ROOT=./storage
BOOK_STORAGE_PATH=./storage/books
COVER_STORAGE_PATH=./storage/covers
PROFILE_IMAGE_STORAGE_PATH=./storage/profiles
MAX_BOOK_SIZE_MB=50
MAX_COVER_SIZE_MB=5
MAX_PROFILE_IMAGE_SIZE_MB=5
