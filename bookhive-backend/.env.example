APP_NAME=BookHive
APP_VERSION=1.0.0
APP_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:4200

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bookhive
DATABASE_USER=postgres
DATABASE_PASSWORD=admin

# Database startup configuration
RESET_DATABASE_ON_STARTUP=false
SEED_DATABASE_ON_STARTUP=true
SEED_DEMO_DATA=false

# Initial administrator
INITIAL_ADMIN_FULL_NAME=BookHive Administrator
INITIAL_ADMIN_USERNAME=bookhive_admin
INITIAL_ADMIN_EMAIL=admin@bookhive.com
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_password

SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

BOOK_STORAGE_PATH=./storage/books
COVER_STORAGE_PATH=./storage/covers
MAX_BOOK_SIZE_MB=50
MAX_COVER_SIZE_MB=5
